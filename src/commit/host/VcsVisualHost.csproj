<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>WinExe</OutputType>
    <AssemblyName>VcsVisualHost</AssemblyName>
    <RootNamespace>VcsVisualHost</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\index.html" Link="Assets\index.html" />
    <EmbeddedResource Include="live.js" Link="Assets\live.js" />
  </ItemGroup>
</Project>
